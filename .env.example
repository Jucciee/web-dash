# The server reads environment variables; it does not load this file automatically.
DASHBOARD_ADDR=127.0.0.1:8080
DASHBOARD_DATA_DIR=./data
DASHBOARD_STATIC_DIR=./web/dist
# Enable when browsers reach the application over HTTPS.
DASHBOARD_COOKIE_SECURE=false
# Optional: leave unset to generate data/setup-token on the first start.
# DASHBOARD_SETUP_TOKEN=replace-with-a-long-random-token
# Console and rotating file logs: debug/info/warn/error, text/json.
DASHBOARD_LOG_LEVEL=info
DASHBOARD_LOG_FORMAT=text
# Default: <DATA_DIR>/logs/dashboard.log. Use - for console only.
# DASHBOARD_LOG_FILE=./data/logs/dashboard.log
# Optional read-only Engine endpoint. Otherwise use DOCKER_HOST or OS default.
# DASHBOARD_DOCKER_HOST=tcp://docker-socket-proxy:2375
# Host metrics: default is the system running web-dash, never a remote Docker host.
# Optional label and disk directory/drive to measure.
# DASHBOARD_HOST_NAME=home-server
# DASHBOARD_HOST_DISK=D:\
# Linux container host metrics require all three read-only mounts.
# Use compose.monitoring.yaml for a ready-to-run Linux example.
# DASHBOARD_HOST_PROC=/host/proc
# DASHBOARD_HOST_SYS=/host/sys
# DASHBOARD_HOST_ROOT=/host/root
